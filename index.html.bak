<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Z Home Roots Realty – Homes & Properties, Tailored For You</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;800&family=Manrope:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f7fd;--surf:#fff;--ink:#0a1f4d;--mut:#4a5d86;--navy:#0b3a8f;--blue:#1e5fd0;--gold:#e8912d;--line:#d3dcef;--hero:#eaf1ff;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#07122b;--surf:#0e2049;--ink:#eaf1ff;--mut:#9db1db;--navy:#7aa5ff;--blue:#5b8cff;--line:#223a73;--hero:#0a1a3d}}
:root[data-theme="dark"]{--bg:#07122b;--surf:#0e2049;--ink:#eaf1ff;--mut:#9db1db;--navy:#7aa5ff;--blue:#5b8cff;--line:#223a73;--hero:#0a1a3d}
html{scroll-behavior:smooth;scroll-padding-top:70px}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 17px/1.6 Manrope,system-ui,sans-serif}
h1,h2,h3{font-family:Fraunces,Georgia,serif;line-height:1.1;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;display:flex;justify-content:space-between;align-items:center;padding:12px 5vw;background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.brand{font:800 20px Fraunces,serif;text-decoration:none;color:var(--navy);display:flex;gap:12px;align-items:center;min-width:0}.brand img{width:66px;height:66px;object-fit:contain;flex-shrink:0}.brand span{line-height:1.15}
nav div a{margin-left:22px;text-decoration:none;font-weight:600;font-size:15px;color:var(--mut)}
nav div a:hover{color:var(--blue)}
.btn{display:inline-block;padding:14px 26px;border-radius:12px;background:var(--navy);color:#fff;font-weight:700;text-decoration:none;border:0;cursor:pointer;font:700 16px Manrope,sans-serif;transition:transform .2s}
:root[data-theme="dark"] .btn,:root:not([data-theme="light"]) .btn{color:#07122b}
.btn:hover{transform:translateY(-3px)}
.btn.alt{background:transparent;color:var(--ink);border:2px solid var(--navy)}
 .hero{position:relative;height:min(760px,calc(100svh - 92px));min-height:540px;overflow:hidden;background:#071a33;color:#fff;padding:0;isolation:isolate}
.hero-slides,.hero-slide{position:absolute;inset:0}.hero-slide{opacity:0;visibility:hidden;transition:opacity .65s ease;pointer-events:none}.hero-slide.active{opacity:1;visibility:visible;pointer-events:auto}
.hero-slide img{width:100%;height:100%;display:block;object-fit:cover;object-position:center}
.slide-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(3,17,39,.86),rgba(3,17,39,.58) 45%,rgba(3,17,39,.10)),linear-gradient(0deg,rgba(3,17,39,.48),transparent 45%)}
.slide-caption{position:absolute;left:max(5vw,calc((100vw - 1150px)/2));bottom:clamp(82px,12vh,130px);width:min(620px,85%);color:#fff}
.slide-caption .eyebrow{display:inline-block;font-size:12px;letter-spacing:.18em;font-weight:800;color:#d9eaff;margin-bottom:15px}
.slide-caption h1{font-size:clamp(34px,5.3vw,66px);font-weight:800;color:#fff;text-shadow:0 2px 18px #0004;margin:0}
.slide-caption p{font-size:clamp(15px,1.7vw,19px);line-height:1.6;color:#f1f5ff;margin:16px 0 24px;max-width:560px}
.hero-actions{display:flex;gap:12px;flex-wrap:wrap}.hero .btn{background:#0b3a8f;color:#fff}.hero .btn.alt{background:#08162d66;border:1px solid #ffffffd9;color:#fff}
.slider-arrow{position:absolute;z-index:3;top:50%;transform:translateY(-50%);width:46px;height:46px;border-radius:50%;border:1px solid #ffffffa6;background:#04122773;color:white;font-size:23px;cursor:pointer;display:grid;place-items:center}
.slider-arrow:hover{background:#0b3a8f}.slider-arrow.prev{left:18px}.slider-arrow.next{right:18px}
.slider-controls{position:absolute;z-index:3;bottom:27px;left:5vw;display:flex;gap:8px;max-width:75%;flex-wrap:wrap}
.slider-dot{width:10px;height:10px;border-radius:99px;padding:0;border:1px solid white;background:#ffffff59;cursor:pointer}.slider-dot.active{width:28px;background:white}
.slide-count{position:absolute;z-index:3;right:5vw;bottom:22px;color:white;font-size:13px;font-weight:700;letter-spacing:.08em}
section{padding:90px 5vw}
.wrap{max-width:1150px;margin:auto}
h2{font-size:clamp(30px,4.5vw,48px);color:var(--navy);margin-bottom:12px}
.lead{color:var(--mut);max-width:560px;margin:0 0 44px}
.grid{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));perspective:1000px}
.card{background:var(--surf);border:1px solid var(--line);border-radius:18px;padding:28px;transform-style:preserve-3d;transition:transform .15s ease-out,box-shadow .2s;will-change:transform}
.card:hover{box-shadow:0 24px 40px -18px rgba(11,58,143,.45)}
.card b{display:block;font:800 22px Fraunces,serif;margin:14px 0 6px;transform:translateZ(30px)}
.card span{color:var(--mut);font-size:15px}
.ic{font-size:34px;display:block;transform:translateZ(50px)}
.deal{background:var(--navy);color:#fff}
:root[data-theme="dark"] .deal,:root:not([data-theme="light"]) .deal{}
.deal h2{color:#fff}.deal .lead{color:#c8d8ff}
.chips{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.chips div{padding:20px;border:1px solid rgba(255,255,255,.28);border-radius:14px;font-weight:700;display:flex;gap:12px;align-items:center;background:rgba(255,255,255,.06)}
.chips em{font-style:normal;font-size:26px}
.why{display:grid;gap:22px;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));text-align:center}
.why div{padding:10px}.why em{font-style:normal;font-size:40px;display:block}
.why b{display:block;font-family:Fraunces,serif;font-size:19px;margin-top:6px}
.contact{display:grid;gap:36px;grid-template-columns:repeat(auto-fit,minmax(300px,1fr))}
.info p{margin:0 0 16px}.info a{color:var(--blue);font-weight:700}
form{display:grid;gap:12px;background:var(--surf);padding:26px;border-radius:18px;border:1px solid var(--line)}
input,select,textarea{font:inherit;padding:13px;border-radius:10px;border:1px solid var(--line);background:var(--bg);color:var(--ink);width:100%}
footer{text-align:center;padding:28px 5vw;color:var(--mut);font-size:14px;border-top:1px solid var(--line)}
.wa{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:11;background:#1fa855;color:#fff;border-radius:50px;padding:13px 20px;font-weight:700;text-decoration:none;box-shadow:0 10px 24px rgba(0,0,0,.3)}
@media(max-width:700px){nav{padding:8px 4vw;gap:8px}.brand{font-size:16px;gap:8px}.brand img{width:48px;height:48px}nav div a:not(.cta){display:none}.hero{height:76svh;min-height:570px;max-height:760px}.slide-caption{left:6vw;bottom:92px;width:88%}.slide-caption h1{font-size:clamp(30px,8vw,46px)}.slide-caption p{font-size:15px;margin:12px 0 18px}.hero-actions{gap:8px}.hero-actions .btn{padding:12px 15px;font-size:14px;margin-left:0!important}.slider-arrow{width:36px;height:36px;font-size:18px}.slider-arrow.prev{left:9px}.slider-arrow.next{right:9px}.slider-controls{left:6vw;bottom:25px;gap:6px;max-width:75%}.slider-dot{width:8px;height:8px}.slider-dot.active{width:22px}.slide-count{right:5vw;bottom:20px;font-size:11px}}@media(max-width:390px){.brand{font-size:14px}.brand img{width:42px;height:42px}.hero-actions .btn{padding:10px 12px}.slide-caption{bottom:100px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
