    <div><em>🎯</em><b>Customer focused</b></div><div><em>🏅</em><b>Quality service</b></div>
    <div><em>🤲</em><b>End to end support</b></div>
  </div>
</div></section>

<section id="contact" style="background:var(--hero)"><div class="wrap contact">
  <div class="info">
    <h2>Let's find your dream property together</h2>
    <p class="lead" style="margin-bottom:24px">Tell us what you're looking for and we'll reply on WhatsApp.</p>
    <p><b>Phone / WhatsApp</b><br><a href="tel:+919211599507">+91 9211599507</a></p>
    <p><b>Office</b><br>1st Floor, Main Road, Badu Bagh, Khanyar, Srinagar, J&K – 190003, India.</p>
    <a class="btn alt" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=Badu+Bagh+Khanyar+Srinagar+190003">Open in Maps</a>
  </div>
  <form id="f">
    <input id="n" placeholder="Your name" required aria-label="Your name">
    <select id="t" aria-label="Property type"><option>Residential property</option><option>Commercial property</option><option>Shop / showroom</option><option>Plot / land</option><option>Industrial property</option><option>Rental / lease</option></select>
    <textarea id="m" rows="4" placeholder="Budget, location, size…" aria-label="Requirement"></textarea>
    <button class="btn" type="submit">Send on WhatsApp</button>
  </form>
</div></section>

<footer>© 2026 Z Home Roots Realty · Homes & Properties, Tailored For You</footer>
<a class="wa" target="_blank" rel="noopener" href="https://wa.me/919211599507">WhatsApp us</a>


<script>
// WhatsApp form
document.getElementById('f').addEventListener('submit',function(e){e.preventDefault();
 var t='Hi Z Home Roots Realty, I am '+n.value+'. Looking for: '+document.getElementById('t').value+'. '+m.value;
 window.open('https://wa.me/919211599507?text='+encodeURIComponent(t),'_blank');});

// Card tilt (CSS 3D)
document.querySelectorAll('.card').forEach(function(c){
 c.addEventListener('pointermove',function(e){var r=c.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
  c.style.transform='rotateY('+x*16+'deg) rotateX('+-y*16+'deg)';});
 c.addEventListener('pointerleave',function(){c.style.transform='';});});

</script>
<script>(function(){const slides=[...document.querySelectorAll('.hero-slide')],dots=[...document.querySelectorAll('.slider-dot')],current=document.getElementById('slide-current'),hero=document.querySelector('.hero');let index=0,timer;function show(n){index=(n+slides.length)%slides.length;slides.forEach((s,i)=>{s.classList.toggle('active',i===index);s.setAttribute('aria-hidden',i===index?'false':'true')});dots.forEach((d,i)=>{d.classList.toggle('active',i===index);d.setAttribute('aria-current',i===index?'true':'false')});if(current)current.textContent=String(index+1).padStart(2,'0')}function restart(){clearInterval(timer);if(!matchMedia('(prefers-reduced-motion: reduce)').matches)timer=setInterval(()=>show(index+1),6000)}document.querySelector('.slider-arrow.prev').addEventListener('click',()=>{show(index-1);restart()});document.querySelector('.slider-arrow.next').addEventListener('click',()=>{show(index+1);restart()});dots.forEach((d,i)=>d.addEventListener('click',()=>{show(i);restart()}));let x=0;hero.addEventListener('touchstart',e=>x=e.changedTouches[0].screenX,{passive:true});hero.addEventListener('touchend',e=>{let dx=e.changedTouches[0].screenX-x;if(Math.abs(dx)>45){show(index+(dx<0?1:-1));restart()}},{passive:true});hero.addEventListener('mouseenter',()=>clearInterval(timer));hero.addEventListener('mouseleave',restart);show(0);restart()})();</script></body>
</html>
